# UTP Platform Environment Variables
# Copy this file to .env and fill in values

# ---- Blockchain ----
RSK_TESTNET_RPC_URL=https://public-node.testnet.rsk.co
RSK_MAINNET_RPC_URL=https://public-node.rsk.co
DEPLOYER_PRIVATE_KEY=
REPORT_GAS=false

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Was missing from this file even though src/lib/supabase.ts and the new
# session-aware clients (src/lib/supabaseAuth/*, src/middleware.ts) both
# read it. Anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# Wallet linking attestation key: server-only, generate 32+ random bytes;
# must match private.wallet_link_settings in the DB.
WALLET_LINK_SECRET=

# Google/GitHub sign-in (/login, src/app/auth/callback): provider client
# id/secret are configured in Supabase Dashboard > Authentication >
# Providers, not here. This is a Supabase-Auth-backed login path that runs
# alongside the existing Privy wallet "Sign In" button in TopBar -- the two
# are independent for now. It exists to activate the auth.users-keyed RLS
# already defined in supabase/migrations/20260711000000_add_bill_actions_
# profiles_tracked.sql (user_profiles, tracked_bills), which nothing wired
# up until now.

# Supabase OAuth 2.1 Server (this project as an OIDC identity provider for
# third-party apps -- see src/app/oauth/consent/page.tsx). Enabled
# per-project in Supabase Dashboard > Authentication > OAuth Server, with
# Authorization Path set to /oauth/consent. Nothing to set here today.

# ---- News API ----
NEWSDATA_API_KEY=
# Get free key: https://newsdata.io/register

# ---- Legislature API ----
CONGRESS_API_KEY=
# Get free key: https://api.congress.gov/sign-up

# ---- Security ----
IP_SALT=change_me_to_random_string

# ---- News Aggregation (optional) ----
MEDIASTACK_API_KEY=
# Get free key: https://mediastack.com/signup/free
WORLD_NEWS_API_KEY=
# ---- AI Infrastructure ----
AI_TIER=local
OLLAMA_API_URL=http://localhost:11434
GOOGLE_GENERATIVE_AI_API_KEY=
