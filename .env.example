# UTP Platform Environment Variables
# Copy this file to .env and fill in values

# ---- Blockchain (Wave 2 Rootstock Testnet & Wave 3 UTP Alpha-Net) ----
NEXT_PUBLIC_CHAIN_ID=31
RSK_TESTNET_RPC_URL=https://public-node.testnet.rsk.co
RSK_MAINNET_RPC_URL=https://public-node.rsk.co
# Voting period in Rootstock blocks (~25.8s/block): 2880 default (~20.7h), 90 for QA rehearsal (~39m)
RSK_TESTNET_VOTING_PERIOD=2880
DEPLOYER_PRIVATE_KEY=
# Multi-signer governance roles (Deployer -> 0 votes post-setup; Voter A & B -> 250k UTP each; non-deployer Guardian)
VOTER_A_ADDRESS=
VOTER_B_ADDRESS=
GUARDIAN_ADDRESS=
REPORT_GAS=false

# Wave 3 UTP Alpha-Net cutover (register in public.chain_networks + deployments/utpAlpha.json)
UTP_ALPHA_CHAIN_ID=
UTP_ALPHA_RPC_URL=

# ---- Frontend & Canonical Auth (Next.js + Supabase) ----
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key used by src/lib/supabase.ts, src/lib/supabaseAuth/*, and src/middleware.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# Wallet linking attestation key: server-only, generate 32+ random bytes;
# must match private.wallet_link_settings in the DB.
WALLET_LINK_SECRET=

# Google/GitHub sign-in (/login, src/app/auth/callback): provider client
# id/secret are configured in Supabase Dashboard > Authentication > Providers.
# TopBar, VotePanel, /api/propose, and SIWE wallet linking all share this
# canonical Supabase Auth session (auth.users + auth.uid() RLS).

# Supabase OAuth 2.1 Server (this project as an OIDC identity provider for
# third-party apps -- see src/app/oauth/consent/page.tsx). Enabled
# per-project in Supabase Dashboard > Authentication > OAuth Server, with
# Authorization Path set to /oauth/consent.

# ---- News API ----
NEWSDATA_API_KEY=
# Get free key: https://newsdata.io/register

# ---- Legislature API ----
CONGRESS_API_KEY=
# Get free key: https://api.congress.gov/sign-up

# ---- Security ----
IP_SALT=change_me_to_random_string

# ---- News Aggregation (optional) ----
MEDIASTACK_API_KEY=
# Get free key: https://mediastack.com/signup/free
WORLD_NEWS_API_KEY=

# ---- AI Infrastructure ----
AI_TIER=local
OLLAMA_API_URL=http://localhost:11434
GOOGLE_GENERATIVE_AI_API_KEY=
